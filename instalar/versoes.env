# Site Estudio: versoes fixas de cada programa.
# Formato: CHAVE=VALOR, uma por linha. Linhas com # sao comentario.
# O instalador do Mac e o do Windows leem este arquivo do mesmo jeito (corta no primeiro "=").
# Ao trocar uma versao, confira de novo o passo correspondente do instalador numa maquina limpa.

# Node (motor dos comandos). LTS 24. O SHA256 de cada arquivo fica fixo aqui (copiado do
# SHASUMS256.txt oficial da mesma versao quando a versao foi escolhida): o instalador confere o
# download contra este valor, e nao contra uma lista baixada do mesmo servidor na hora.
# Ao trocar NODE_VERSAO, troque os quatro SHA256 juntos.
NODE_VERSAO=24.22.3
NODE_SHA256_DARWIN_ARM64=1d64136c8a43d648d1b3bad10797a4c995b1ca032d2bde8799de43b37f058fe5
NODE_SHA256_DARWIN_X64=4daeec962855c1a6e66cda398a25037319dc1bbd4a0939188b3547afbbfb6490
NODE_SHA256_WIN_X64=e612af99f626ab415ea225af6bce5c971feb448cb5cae250bb1c3fa50c5f7d9f
NODE_SHA256_WIN_ARM64=b3cc74a295b39d4f273271e96f58c06dd2b35757ca12abec64c7d0598b434f14

# Navegador escondido (chrome-headless-shell, Chrome for Testing). Mede as paginas, roda a
# conferencia de acessibilidade e tira as fotos em 4 tamanhos.
# Baixado por @puppeteer/browsers, que vem em devDependencies do package.json com a arvore
# inteira fixa no package-lock.json ("npm ci" no passo pacotes). O instalador roda o que ficou em
# node_modules, nunca "npx" (que resolveria as dependencias dele na hora, sem lock).
# PUPPETEER_BROWSERS_VERSAO precisa ser igual a do package.json (o teste confere).
CHROME_HEADLESS_SHELL_VERSAO=152.0.7977.30
PUPPETEER_BROWSERS_VERSAO=3.2.7

# Limites.
ESPACO_MINIMO_GB=2
ESPACO_MINIMO_VERIFICAR_GB=1
MEMORIA_MINIMA_GB=8
MAC_MINIMO=13.5
WINDOWS_BUILD_MINIMO=19045

# Atualizacao: endereco do zip da versao mais nova. O "atualizar" so aceita
# https://github.com/autonom-ia/site-estudio/... e exige, ao lado do zip, o arquivo
# site-estudio.zip.sha256 publicado na mesma release (ver comandos-unicos.md, "Publicar uma versao").
ESTUDIO_ATUALIZAR_URL=https://github.com/autonom-ia/site-estudio/releases/latest/download/site-estudio.zip
